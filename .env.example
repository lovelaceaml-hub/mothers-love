# Public client configuration. Leave blank to keep collection closed until the provider is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only restricted campaign login through the transaction pooler. Never expose this value to the browser.
DATABASE_URL=

# Server-only Supabase CA certificate PEM. Use the dashboard certificate, with literal newlines or escaped backslash-n sequences.
# A configured remote database is closed unless this validates.
DATABASE_CA_CERT=
